  <bpmn:process id="Process_1xg5vc4" isExecutable="false">

    <bpmn:startEvent id="StartEvent_09b8lt9">
      <bpmn:outgoing>Flow_01b69o7</bpmn:outgoing>
    </bpmn:startEvent>

    <bpmn:task id="Activity_0jjwrj3"
      name="Start Event: The process begins once load data from slabs and columns is available">
      <bpmn:incoming>Flow_01b69o7</bpmn:incoming>
      <bpmn:outgoing>Flow_16owx5p</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Activity_1ntwjdr"
      name="Calculate Slab and Column Loads: The script gathers load data from previous structural analysis or simulation results.">
      <bpmn:incoming>Flow_16owx5p</bpmn:incoming>
      <bpmn:outgoing>Flow_1qrhe3o</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Activity_0j2ruix"
      name="Calculate Column Capacity – Python scripts, using IfcOpenShell or other tools, compute the design axial capacity NRd for each column based on geometry, material data, and reinforcement details.">
      <bpmn:incoming>Flow_1qrhe3o</bpmn:incoming>
      <bpmn:outgoing>Flow_0urgzv9</bpmn:outgoing>
    </bpmn:task>

    <bpmn:exclusiveGateway id="Gateway_08c38qu">
      <bpmn:incoming>Flow_0urgzv9</bpmn:incoming>
      <bpmn:outgoing>Flow_0vwa8n1</bpmn:outgoing>
      <bpmn:outgoing>Flow_0hyczk7</bpmn:outgoing>
    </bpmn:exclusiveGateway>

    <bpmn:task id="Activity_0axoawz"
      name="No → Process requires revision. If capacity is exceeded, the process stops and flags the relevant columns for redesign or further review.">
      <bpmn:incoming>Flow_0vwa8n1</bpmn:incoming>
    </bpmn:task>

    <bpmn:task id="Activity_0ifdfgt"
      name="Yes → Generate Report in Python. If utilization is acceptable, the script compiles all results into a formatted report including column IDs, capacities, and utilization factors.">
      <bpmn:incoming>Flow_0hyczk7</bpmn:incoming>
      <bpmn:outgoing>Flow_0hqzdzb</bpmn:outgoing>
    </bpmn:task>

    <bpmn:task id="Activity_09itp6b"
      name="End Event – The process completes when all columns are evaluated and the report is generated.">
      <bpmn:incoming>Flow_0hqzdzb</bpmn:incoming>
    </bpmn:task>

    <bpmn:textAnnotation id="TextAnnotation_0dmdx60">
      <bpmn:text>Decision: Capacity Utilization OK? The process evaluates whether the calculated load/utilization ratio for each column is within acceptable limits.</bpmn:text>
    </bpmn:textAnnotation>

    <bpmn:association id="Association_1jjfolh"
